2026-09-30T22:05:24.6353156Z # System-wide .bashrc file for interactive bash(1) shells.
2026-09-30T22:05:24.6353568Z 
2026-09-30T22:05:24.6353903Z # To enable the settings / commands in this file for login shells as well,
2026-09-30T22:05:24.6354608Z # this file has to be sourced in /etc/profile.
2026-09-30T22:05:24.6355218Z 
2026-09-30T22:05:24.6355428Z # If not running interactively, don't do anything
2026-09-30T22:05:24.6355937Z [ -z "$PS1" ] && return
2026-09-30T22:05:24.6356186Z 
2026-09-30T22:05:24.6356455Z # check the window size after each command and, if necessary,
2026-09-30T22:05:24.6357044Z # update the values of LINES and COLUMNS.
2026-09-30T22:05:24.6357499Z shopt -s checkwinsize
2026-09-30T22:05:24.6357717Z 
2026-09-30T22:05:24.6358072Z # set variable identifying the chroot you work in (used in the prompt below)
2026-09-30T22:05:24.6358855Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-09-30T22:05:24.6359446Z     debian_chroot=$(cat /etc/debian_chroot)
2026-09-30T22:05:24.6359886Z fi
2026-09-30T22:05:24.6360046Z 
2026-09-30T22:05:24.6360330Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-09-30T22:05:24.6361020Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-09-30T22:05:24.6361528Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-09-30T22:05:24.6361858Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-09-30T22:05:24.6362159Z fi
2026-09-30T22:05:24.6362275Z 
2026-09-30T22:05:24.6362503Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-09-30T22:05:24.6362915Z # If this is an xterm set the title to user@host:dir
2026-09-30T22:05:24.6363196Z #case "$TERM" in
2026-09-30T22:05:24.6363385Z #xterm*|rxvt*)
2026-09-30T22:05:24.6363676Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-09-30T22:05:24.6364014Z #    ;;
2026-09-30T22:05:24.6364179Z #*)
2026-09-30T22:05:24.6364370Z #    ;;
2026-09-30T22:05:24.6364547Z #esac
2026-09-30T22:05:24.6364668Z 
2026-09-30T22:05:24.6365047Z # enable bash completion in interactive shells
2026-09-30T22:05:24.6365554Z #if ! shopt -oq posix; then
2026-09-30T22:05:24.6365858Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
