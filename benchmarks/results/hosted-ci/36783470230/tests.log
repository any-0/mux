2026-09-30T22:05:24.6367201Z #  fi
2026-09-30T22:05:24.6367362Z #fi
2026-09-30T22:05:24.6367457Z 
2026-09-30T22:05:24.6367533Z # sudo hint
2026-09-30T22:05:24.6367834Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-09-30T22:05:24.6368231Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-09-30T22:05:24.6368509Z     if [ -x /usr/bin/sudo ]; then
2026-09-30T22:05:24.6368740Z 	cat <<-EOF
2026-09-30T22:05:24.6369134Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-09-30T22:05:24.6369493Z 	See "man sudo_root" for details.
2026-09-30T22:05:24.6369711Z 	
2026-09-30T22:05:24.6369861Z 	EOF
2026-09-30T22:05:24.6370017Z     fi
2026-09-30T22:05:24.6370180Z     esac
2026-09-30T22:05:24.6370339Z fi
2026-09-30T22:05:24.6370431Z 
2026-09-30T22:05:24.6370573Z # if the command-not-found package is installed, use it
2026-09-30T22:05:24.6371050Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-09-30T22:05:24.6371493Z 	function command_not_found_handle {
